ansible_python_interpreter: /usr/bin/python3
web_private_ip: "WEB_PRIVATE_IP"
monitoring_private_ip: "MONITORING_PRIVATE_IP"
app_image: "ghcr.io/uday2327/aws-health-app:latest"
app_port: 3000
